{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "padding": {
      "top": 1,
      "left": 2,
      "right": 2
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "cyan"
    }
  },
  "modules": [
    {
      "key": "╭────────────╮",
      "type": "custom"
    },
    {
      "key": "│ {#39} user     {#keys}│",
      "type": "title",
      "format": "{user-name}"
    },
    {
      "key": "│ {#39}󰇅 hostname {#keys}│",
      "type": "title",
      "format": "{host-name}"
    },
    {
      "key": "│ {#39}󰅐 uptime   {#keys}│",
      "type": "uptime"
    },
    {
      "key": "│ {#39}󰃭 os age   {#keys}│",
      "type": "command",
      "text": "birth=$(stat -c %W / 2>/dev/null || stat -f %B /Users); now=$(date +%s); echo \"$(( (now - birth) / 86400 )) days\""
    },
    {
      "key": "│ {#39}{icon} distro   {#keys}│",
      "type": "os"
    },
    {
      "key": "│ {#39} kernel   {#keys}│",
      "type": "kernel"
    },
    {
      "key": "│ {#39}󰇄 desktop  {#keys}│",
      "type": "de"
    },
    {
      "key": "│ {#39}󰖲 wm       {#keys}│",
      "type": "wm"
    },
    {
      "key": "│ {#39} term     {#keys}│",
      "type": "terminal"
    },
    {
      "key": "│ {#39} shell    {#keys}│",
      "type": "shell"
    },
    {
      "key": "│ {#39}󰍛 cpu      {#keys}│",
      "type": "cpu",
      "showPeCoreCount": true
    },
    {
      "key": "│ {#39}󰢮 gpu      {#keys}│",
      "type": "gpu"
    },
    {
      "key": "│ {#39}󰉉 disk     {#keys}│",
      "type": "disk",
      "folders": "/"
    },
    {
      "key": "│ {#39} memory   {#keys}│",
      "type": "memory"
    },
    {
      "key": "├────────────┤",
      "type": "custom"
    },
    {
      "key": "│ {#39} colors   {#keys}│",
      "type": "colors",
      "symbol": "circle"
    },
    {
      "key": "│ {#39}󰎈 media    {#keys}│",
      "type": "media",
      "format": "{title} - {artist}"
    },
    {
      "key": "╰────────────╯",
      "type": "custom"
    }
  ]
}